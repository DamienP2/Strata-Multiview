#!/bin/sh
# Runs as root after the payload is copied.
set -e
PREFIX=/usr/local/strata-multiview
mkdir -p /usr/local/bin
ln -sf "$PREFIX/strata-mv-server" /usr/local/bin/strata-mv-server
# Let other machines reach the web UI and NDI outputs through the macOS
# firewall. Done here, before the service starts: it signs the program in
# place, which must never happen to a running one.
FW=/usr/libexec/ApplicationFirewall/socketfilterfw
LOG="/Library/Logs/Strata Multiview/install.log"
mkdir -p "/Library/Logs/Strata Multiview"
allowed() { "$FW" --listapps 2>/dev/null | grep -qF "$PREFIX/strata-mv-server"; }
if "$FW" --getglobalstate 2>&1 | grep -q "State = [12]"; then
  {
    echo "--- $(date) firewall"
    "$FW" --add "$PREFIX/strata-mv-server" 2>&1
    "$FW" --unblockapp "$PREFIX/strata-mv-server" 2>&1
    # Not taken (a signature it would not read): signed ad hoc, then again.
    if ! allowed; then
      codesign --force --sign - --identifier com.stratamultiview.server "$PREFIX/strata-mv-server" 2>&1
      "$FW" --add "$PREFIX/strata-mv-server" 2>&1
      "$FW" --unblockapp "$PREFIX/strata-mv-server" 2>&1
    fi
    allowed && echo "allowed through the firewall" || echo "NOT allowed through the firewall"
  } >>"$LOG" 2>&1 || true
fi
"$PREFIX/strata-mv-server" service install

# Let administrators start the server from the menu bar without a password
# prompt (stop and restart go through the server itself). Only this exact
# command, and only if sudo accepts the file.
RULE=/etc/sudoers.d/strata-multiview
TMP=$(mktemp)
echo "%admin ALL=(root) NOPASSWD: $PREFIX/strata-mv-server service start" > "$TMP"
if visudo -cf "$TMP" >/dev/null 2>&1; then
  install -m 0440 -o root -g wheel "$TMP" "$RULE"
fi
rm -f "$TMP"

# Start the menu bar app for the logged-in user (it also starts at login).
USER_ID=$(stat -f %u /dev/console 2>/dev/null || echo 0)
if [ "$USER_ID" != "0" ]; then
  launchctl bootstrap "gui/$USER_ID" /Library/LaunchAgents/com.stratamultiview.tray.plist 2>/dev/null || true
fi
exit 0
